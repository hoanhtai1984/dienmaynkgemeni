DATABASE_URL="mysql://root:@localhost:3306/dienmaynk"
PORT=4000
JWT_SECRET="change-me"
ADMIN_EMAIL="admin@dienmaynk.vn"
ADMIN_PASSWORD="change-me"
CLIENT_URL="http://localhost:5173"

# Mã hoá mật khẩu SMTP trước khi lưu DB - bắt buộc, server sẽ báo lỗi khi
# lưu/đọc giá trị đó nếu thiếu. Tạo bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY="change-me-64-hex-chars"

# Gửi email đặt lại mật khẩu cho khách hàng. Bỏ trống khi dev - link đặt lại
# mật khẩu sẽ được in ra console server thay vì gửi email thật.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Điện Máy NK <no-reply@dienmaynk.vn>"

# Theo dõi lỗi tập trung (Sentry). Bỏ trống khi dev - lỗi vẫn được log đầy đủ
# ra console, chỉ là không có ai được báo tự động. Để bật: tạo tài khoản
# miễn phí tại sentry.io, tạo project Node.js, dán DSN được cấp vào đây.
SENTRY_DSN=""

# Mức log tối thiểu được ghi ra (xem server/src/lib/logger.js) - "info" là mặc
# định phù hợp cho production, dùng "debug" khi cần soi kỹ lúc dev.
LOG_LEVEL="info"
