DATABASE_URL="mysql://<user>:<password>@<host>:3306/<database>"
PORT=4000
JWT_SECRET="<random-long-secret-generate-your-own>"
ADMIN_EMAIL="admin@dienmaynk.vn"
ADMIN_PASSWORD="<strong-password-change-me>"
CLIENT_URL="https://your-frontend-domain.com"

# Bắt buộc nếu host không tự set sẵn (Railway/Render thường tự set, VPS/PM2
# thì không) - thiếu biến này cookie đăng nhập thiếu cờ Secure và CORS lỏng
# hơn cần thiết.
NODE_ENV="production"

# Chỉ set =true khi client và server ở 2 domain KHÁC nhau (vd client Vercel,
# server Railway - đúng kịch bản CLIENT_URL ở trên). Để trống/false nếu
# client+server cùng domain qua reverse proxy.
COOKIE_CROSS_SITE=""

# Bắt buộc - mã hoá mật khẩu SMTP lưu trong DB. Tạo bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Đổi key này ở production sẽ khiến giá trị đã lưu trước đó không đọc lại
# được, phải vào Admin > Cài đặt nhập lại.
SECRETS_ENCRYPTION_KEY="<64-hex-chars-tu-lenh-tren>"

# Bắt buộc để "Quên mật khẩu" gửi được email thật (không có thì link chỉ in
# ra log server, khách hàng không nhận được).
SMTP_HOST="<smtp-host-cua-nha-cung-cap-email>"
SMTP_PORT="587"
SMTP_USER="<smtp-username>"
SMTP_PASS="<smtp-password-or-api-key>"
MAIL_FROM="Điện Máy NK <no-reply@dienmaynk.vn>"

# Khuyến nghị mạnh cho production - không có thì lỗi ngầm (vd: crash lúc
# 2h sáng) sẽ không ai biết cho tới khi khách phàn nàn. Tạo tài khoản miễn
# phí tại sentry.io -> tạo project Node.js -> dán DSN được cấp vào đây.
SENTRY_DSN="<dsn-lay-tu-sentry.io>"

# Mức log tối thiểu được ghi ra (xem server/src/lib/logger.js) - "info" phù
# hợp cho production.
LOG_LEVEL="info"
